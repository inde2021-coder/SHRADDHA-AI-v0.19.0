PORT=8787
GATEWAY_TOKEN=generate-a-unique-32-byte-random-secret-and-store-it-only-on-the-server # enter same token in Android secure voice backend settings
# JSON object: {"shraddha.core":"<Base64 DER Ed25519 public key>"}; keep private signing keys offline
PLUGIN_TRUSTED_PUBLIC_KEYS={}
GEMINI_API_KEY= # Server only: also used to mint one-use Gemini Live tokens
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional model overrides used for screenshot/vision analysis
GEMINI_VISION_MODEL=gemini-3.8-flash
OPENAI_VISION_MODEL=gpt-4.1-mini
ANTHROPIC_VISION_MODEL=claude-sonnet-5

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# Optional automatic AI failover order (only configured providers are used).
# AI_DEFAULT_PROVIDER is tried first; then AI_PROVIDER_ORDER; then remaining providers.
AI_DEFAULT_PROVIDER=gemini
AI_PROVIDER_ORDER=gemini,openai,anthropic,groq,perplexity
# Shraddha's own non-Google speech output. Deploy a licensed bilingual custom voice
# model behind an HTTPS endpoint that returns raw mono PCM s16le at 24000 Hz.
SHRADDHA_TTS_URL=
SHRADDHA_TTS_TOKEN=
SHRADDHA_TTS_VOICE=shraddha

# Optional authorized social publishing. Credentials stay on the backend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
MASTODON_VISIBILITY=unlisted

# Edesy inbound AI voice streaming (server only; never place these values in Android)
EDESY_STREAM_TOKEN=generate-a-long-random-token-for-the-provider-websocket-url
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
SHRADDHA_CALL_INSTRUCTIONS=You are Shraddha AI. Tell callers you are an AI assistant. Speak Hindi or English naturally.
# Transcript capture is disabled by default; enable only after legal/privacy review and caller notice.
CALL_TRANSCRIPTS_ENABLED=false

# Optional provider-integrated SMS / WhatsApp delivery (server-side only)
# Never place these credentials in the Android app or commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

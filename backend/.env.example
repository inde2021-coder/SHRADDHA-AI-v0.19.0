PORT=8787
GATEWAY_TOKEN=generate-a-unique-32-byte-random-secret-and-store-it-only-on-the-server
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GEMINI_VISION_MODEL=gemini-2.5-flash
OPENAI_VISION_MODEL=gpt-4.1-mini
ANTHROPIC_VISION_MODEL=claude-3-5-haiku-latest

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Knowlarity cloud telephony (keep all values server-side; never put them in the Android app)
KNOWLARITY_API_KEY=
KNOWLARITY_SR_API_KEY=
KNOWLARITY_NUMBER=+91XXXXXXXXXX
KNOWLARITY_CHANNEL=Basic
KNOWLARITY_WEBHOOK_TOKEN=generate-a-long-random-secret

# Edesy inbound AI voice streaming (server only)
EDESY_STREAM_TOKEN=generate-a-long-random-token-for-the-provider-websocket-url
OPENAI_LIVE_MODEL=gpt-live-1.1
OPENAI_LIVE_VOICE=marin
SHRADDHA_CALL_INSTRUCTIONS=You are Shraddha AI. Tell callers you are an AI assistant. Speak Hindi or English naturally.

# Optional: enable live transcript capture and post-call AI summaries only after consent/privacy review
CALL_TRANSCRIPTS_ENABLED=false
EDESY_TRANSCRIPTION_CONSENT_SOURCE=

PORT=8787
GATEWAY_TOKEN=generate-a-unique-32-byte-random-secret-and-store-it-only-on-the-server
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional model overrides used for screenshot/vision analysis
GEMINI_VISION_MODEL=gemini-3.8-flash
OPENAI_VISION_MODEL=gpt-4.1-mini
ANTHROPIC_VISION_MODEL=claude-sonnet-5

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PERPLEXITY_API_KEY=
PERPLEXITY_EFFORT=fast
# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# Edesy inbound AI call streaming (server-side only; never add these to Android)
EDESY_STREAM_TOKEN=generate-a-long-random-token-for-provider-websocket-ingress
EDESY_API_KEY=sk_your-edesy-voice-api-key
EDESY_STREAM_URL=wss://your-backend-domain.example/ws/telephony/edesy?token=generate-a-long-random-token-for-provider-websocket-ingress
PUBLIC_ORIGIN=https://your-backend-domain.example
OPENAI_LIVE_MODEL=gpt-live-1.1
OPENAI_LIVE_VOICE=marin
SHRADDHA_CALL_AGENT_NAME=Shraddha AI
SHRADDHA_CALL_INSTRUCTIONS=You are the configured call assistant, an AI assistant. At the start of every call clearly disclose that you are an AI assistant. Speak naturally in Hindi or English, take a concise message, and never claim to perform an action you cannot perform.
# Transcript saving requires per-call DTMF 1 consent; DTMF 0 stops and purges. Keep OFF until legal notice/retention review.
CALL_TRANSCRIPTS_ENABLED=false
EDESY_MAX_CONCURRENT_CALLS=8

# Optional durable encrypted inbound-call history (server-side secrets only).
# Use the Firebase service-account JSON for the same project; never commit a real value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Generate 32 random bytes, then base64-encode them; keep this key outside Firebase.
CALL_HISTORY_ENCRYPTION_KEY=

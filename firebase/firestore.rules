rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/vault/{documentId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && documentId.matches('^[a-zA-Z0-9_-]{1,64}$')
                            && request.resource.data.keys().hasOnly(['format', 'payload', 'updatedAt'])
                            && request.resource.data.format == 'AES-256-GCM/PBKDF2-SHA256-v1'
                            && request.resource.data.payload is string
                            && request.resource.data.payload.size() < 200000
                            && request.resource.data.updatedAt is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/backups/{backupId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && backupId.matches('^backup_[0-9]{10,}_[a-f0-9]{8}\\.enc$')
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream'
        && request.resource.metadata.format == 'AES-256-GCM/PBKDF2-SHA256-v1'
        && request.resource.metadata.updatedAt.matches('^[0-9]{10,}$');
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && backupId.matches('^backup_[0-9]{10,}_[a-f0-9]{8}\\.enc$');
    }
    match /social-media/{userId}/{mediaId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && mediaId.matches('^[a-f0-9]{32}
  }
}
)
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.metadata.ownerUid == userId
        && request.resource.metadata.purpose == 'social-publishing'
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'video/mp4'];
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
